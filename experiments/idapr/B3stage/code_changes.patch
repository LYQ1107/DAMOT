+                           in_energy_sum=float(in2.sum().detach()),
+                           full_energy_sum=float(full2.sum().detach()),
+                           full_reference_loss=(float((1.0 - cos_roi[gate_mask]).mean().detach())
+                                                if gate_mask.any() else None))
+    if gate_mask.sum() == 0:
+        return None, cos_roi, gate_mask
+    loss = (1.0 - per_roi[gate_mask]).mean()
+    return loss, cos_roi, gate_mask
