+def roi_proto_release_normalized(feats, prototypes, space_basis, topk=3,
+                                 sim_gate_thr=None, space_stats=None):
+    """Release a fixed subspace; inputs are the normalized feature nodes.
+
+    Neighbors and gating are selected by the unchanged full-space cosine.
+    Keeping this helper at the normalized nodes also makes the geometric
+    gradient condition directly testable, before the normalization Jacobian.
+    """
+    e = space_basis.detach().to(device=feats.device, dtype=feats.dtype)
+    if e.ndim != 2 or e.shape[0] != feats.shape[1]:
+        raise ValueError('APR space basis must have shape [D,k]')
+    sim = feats @ prototypes.t()
+    k = min(topk, sim.size(1))
+    topv, topi = sim.topk(k=k, dim=1)
+    d = feats.unsqueeze(1) - prototypes[topi]
+    full2 = d.square().sum(-1)
+    in2 = (d @ e).square().sum(-1)
+    dist = 0.5 * (full2 - in2)
+    per_roi = 1.0 - dist.mean(dim=1)
+    cos_roi = topv.mean(dim=1)
+    gate_mask = (torch.ones_like(cos_roi, dtype=torch.bool)
+                 if sim_gate_thr is None else cos_roi.detach() >= float(sim_gate_thr))
